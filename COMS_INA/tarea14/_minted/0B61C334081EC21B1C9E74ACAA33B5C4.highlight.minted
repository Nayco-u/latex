\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{ber\PYGZus{}qpsk\PYGZus{}awgn}\PYG{p}{(}\PYG{n}{EbN0\PYGZus{}lin}\PYG{p}{):}
