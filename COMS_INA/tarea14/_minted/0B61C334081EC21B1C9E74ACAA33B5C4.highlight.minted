\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{get\PYGZus{}xp}\PYG{p}{(}\PYG{n}{use\PYGZus{}gpu}\PYG{o}{=}\PYG{k+kc}{False}\PYG{p}{):}
