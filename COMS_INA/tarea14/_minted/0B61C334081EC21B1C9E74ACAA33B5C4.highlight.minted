\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{ber\PYGZus{}qpsk\PYGZus{}rayleigh}\PYG{p}{(}\PYG{n}{EbN0\PYGZus{}lin}\PYG{p}{):}
