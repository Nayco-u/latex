\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{qpsk\PYGZus{}mod\PYGZus{}bits\PYGZus{}to\PYGZus{}symbols}\PYG{p}{(}\PYG{n}{bits}\PYG{p}{,} \PYG{n}{xp}\PYG{p}{):}
    \PYG{n}{b0} \PYG{o}{=} \PYG{l+m+mi}{1} \PYG{o}{\PYGZhy{}} \PYG{l+m+mi}{2}\PYG{o}{*}\PYG{n}{bits}\PYG{p}{[}\PYG{o}{...}\PYG{p}{,}\PYG{l+m+mi}{0}\PYG{p}{]}
