    \PYG{k}{return} \PYG{p}{(}\PYG{n}{b0} \PYG{o}{+} \PYG{l+m+mi}{1}\PYG{n}{j}\PYG{o}{*}\PYG{n}{b1}\PYG{p}{)} \PYG{o}{/} \PYG{n}{xp}\PYG{o}{.}\PYG{n}{sqrt}\PYG{p}{(}\PYG{l+m+mi}{2}\PYG{p}{)}

\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{qpsk\PYGZus{}demod\PYGZus{}symbols\PYGZus{}to\PYGZus{}bits}\PYG{p}{(}\PYG{n}{symbols}\PYG{p}{,} \PYG{n}{xp}\PYG{p}{):}
    \PYG{n}{bits0} \PYG{o}{=} \PYG{p}{(}\PYG{n}{symbols}\PYG{o}{.}\PYG{n}{real} \PYG{o}{\PYGZlt{}} \PYG{l+m+mi}{0}\PYG{p}{)}\PYG{o}{.}\PYG{n}{astype}\PYG{p}{(}\PYG{n}{xp}\PYG{o}{.}\PYG{n}{int8}\PYG{p}{)}
    \PYG{n}{bits1} \PYG{o}{=} \PYG{p}{(}\PYG{n}{symbols}\PYG{o}{.}\PYG{n}{imag} \PYG{o}{\PYGZlt{}} \PYG{l+m+mi}{0}\PYG{p}{)}\PYG{o}{.}\PYG{n}{astype}\PYG{p}{(}\PYG{n}{xp}\PYG{o}{.}\PYG{n}{int8}\PYG{p}{)}
    \PYG{k}{return} \PYG{n}{xp}\PYG{o}{.}\PYG{n}{stack}\PYG{p}{([}\PYG{n}{bits0}\PYG{p}{,} \PYG{n}{bits1}\PYG{p}{],} \PYG{n}{axis}\PYG{o}{=\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{)}

\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{awgn\PYGZus{}noise}\PYG{p}{(}\PYG{n}{shape}\PYG{p}{,} \PYG{n}{N0}\PYG{p}{,} \PYG{n}{xp}\PYG{p}{):}
    \PYG{n}{sigma} \PYG{o}{=} \PYG{n}{xp}\PYG{o}{.}\PYG{n}{sqrt}\PYG{p}{(}\PYG{n}{N0}\PYG{o}{/}\PYG{l+m+mf}{2.0}\PYG{p}{)}
