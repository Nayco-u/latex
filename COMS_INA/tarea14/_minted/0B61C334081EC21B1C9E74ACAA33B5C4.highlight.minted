\PYG{c+c1}{\PYGZsh{} Cell: Generadores batch}
\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{gen\PYGZus{}rayleigh\PYGZus{}channel\PYGZus{}batch}\PYG{p}{(}\PYG{n}{N}\PYG{p}{,} \PYG{n}{Nr}\PYG{p}{,} \PYG{n}{Nt}\PYG{p}{,} \PYG{n}{xp}\PYG{p}{):}
    \PYG{n}{real} \PYG{o}{=} \PYG{n}{xp}\PYG{o}{.}\PYG{n}{random}\PYG{o}{.}\PYG{n}{normal}\PYG{p}{(}\PYG{n}{size}\PYG{o}{=}\PYG{p}{(}\PYG{n}{N}\PYG{p}{,} \PYG{n}{Nr}\PYG{p}{,} \PYG{n}{Nt}\PYG{p}{))}
    \PYG{n}{imag} \PYG{o}{=} \PYG{n}{xp}\PYG{o}{.}\PYG{n}{random}\PYG{o}{.}\PYG{n}{normal}\PYG{p}{(}\PYG{n}{size}\PYG{o}{=}\PYG{p}{(}\PYG{n}{N}\PYG{p}{,} \PYG{n}{Nr}\PYG{p}{,} \PYG{n}{Nt}\PYG{p}{))}
    \PYG{k}{return} \PYG{p}{(}\PYG{n}{real} \PYG{o}{+} \PYG{l+m+mi}{1}\PYG{n}{j}\PYG{o}{*}\PYG{n}{imag}\PYG{p}{)} \PYG{o}{/} \PYG{n}{xp}\PYG{o}{.}\PYG{n}{sqrt}\PYG{p}{(}\PYG{l+m+mf}{2.0}\PYG{p}{)}

\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{gen\PYGZus{}qpsk\PYGZus{}symbols\PYGZus{}batch}\PYG{p}{(}\PYG{n}{N}\PYG{p}{,} \PYG{n}{Nt}\PYG{p}{,} \PYG{n}{Ns}\PYG{p}{,} \PYG{n}{Es\PYGZus{}per\PYGZus{}stream}\PYG{p}{,} \PYG{n}{xp}\PYG{p}{):}
    \PYG{c+c1}{\PYGZsh{} Devuelve S\PYGZus{}symbols shape (N, Nt, Ns) y bits (N,Nt,Ns,2)}
    \PYG{n}{bits} \PYG{o}{=} \PYG{n}{xp}\PYG{o}{.}\PYG{n}{random}\PYG{o}{.}\PYG{n}{randint}\PYG{p}{(}\PYG{l+m+mi}{0}\PYG{p}{,} \PYG{l+m+mi}{2}\PYG{p}{,} \PYG{n}{size}\PYG{o}{=}\PYG{p}{(}\PYG{n}{N}\PYG{p}{,} \PYG{n}{Nt}\PYG{p}{,} \PYG{n}{Ns}\PYG{p}{,} \PYG{l+m+mi}{2}\PYG{p}{))}
    \PYG{n}{S} \PYG{o}{=} \PYG{n}{qpsk\PYGZus{}mod\PYGZus{}bits\PYGZus{}to\PYGZus{}symbols}\PYG{p}{(}\PYG{n}{bits}\PYG{p}{,} \PYG{n}{xp}\PYG{p}{)}   \PYG{c+c1}{\PYGZsh{} (N, Nt, Ns)}
    \PYG{n}{S} \PYG{o}{=} \PYG{n}{S} \PYG{o}{*} \PYG{n}{xp}\PYG{o}{.}\PYG{n}{sqrt}\PYG{p}{(}\PYG{n}{Es\PYGZus{}per\PYGZus{}stream}\PYG{p}{)}
    \PYG{k}{return} \PYG{n}{S}\PYG{p}{,} \PYG{n}{bits}



\PYG{c+c1}{\PYGZsh{} Cell: Transmisión + decodificación ZF en receptor}
\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{transmit\PYGZus{}and\PYGZus{}zf\PYGZus{}decode}\PYG{p}{(}\PYG{n}{H}\PYG{p}{,} \PYG{n}{S\PYGZus{}streams}\PYG{p}{,} \PYG{n}{N0}\PYG{p}{,} \PYG{n}{Es}\PYG{p}{,} \PYG{n}{xp}\PYG{p}{):}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{    H: (N, Nr, Nt)}
\PYG{l+s+sd}{    S\PYGZus{}streams: (N, Nt, Ns) \PYGZhy{}\PYGZgt{} símbolos transmitidos por cada antena tx}
\PYG{l+s+sd}{    Retorna: S\PYGZus{}hat (N, Nt, Ns), S\PYGZus{}streams (N,Nt,Ns)}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{n}{N}\PYG{p}{,} \PYG{n}{Nr}\PYG{p}{,} \PYG{n}{Nt} \PYG{o}{=} \PYG{n}{H}\PYG{o}{.}\PYG{n}{shape}
    \PYG{n}{\PYGZus{}}\PYG{p}{,} \PYG{n}{Nt2}\PYG{p}{,} \PYG{n}{Ns} \PYG{o}{=} \PYG{n}{S\PYGZus{}streams}\PYG{o}{.}\PYG{n}{shape}
    \PYG{k}{assert} \PYG{n}{Nt2} \PYG{o}{==} \PYG{n}{Nt}

    \PYG{c+c1}{\PYGZsh{} Transmitir: X = S\PYGZus{}streams (cada antena tx transmite su secuencia)}
    \PYG{n}{X} \PYG{o}{=} \PYG{n}{S\PYGZus{}streams}  \PYG{c+c1}{\PYGZsh{} (N, Nt, Ns)}
    \PYG{n}{Y} \PYG{o}{=} \PYG{n}{xp}\PYG{o}{.}\PYG{n}{einsum}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}nij, njs \PYGZhy{}\PYGZgt{} nis\PYGZsq{}}\PYG{p}{,} \PYG{n}{H}\PYG{p}{,} \PYG{n}{X}\PYG{p}{)}          \PYG{c+c1}{\PYGZsh{} (N, Nr, Ns)}
    \PYG{n}{Y} \PYG{o}{+=} \PYG{n}{awgn\PYGZus{}noise}\PYG{p}{(}\PYG{n}{Y}\PYG{o}{.}\PYG{n}{shape}\PYG{p}{,} \PYG{n}{N0}\PYG{p}{,} \PYG{n}{xp}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} Decodificación ZF: W\PYGZus{}zf = (H\PYGZca{}H H)\PYGZca{}\PYGZob{}\PYGZhy{}1\PYGZcb{} H\PYGZca{}H   \PYGZhy{}\PYGZgt{} shape (N, Nt, Nr)}
    \PYG{n}{H\PYGZus{}H} \PYG{o}{=} \PYG{n}{H}\PYG{o}{.}\PYG{n}{conj}\PYG{p}{()}\PYG{o}{.}\PYG{n}{transpose}\PYG{p}{(}\PYG{l+m+mi}{0}\PYG{p}{,} \PYG{l+m+mi}{2}\PYG{p}{,} \PYG{l+m+mi}{1}\PYG{p}{)}              \PYG{c+c1}{\PYGZsh{} (N, Nt, Nr)}
    \PYG{n}{R} \PYG{o}{=} \PYG{n}{xp}\PYG{o}{.}\PYG{n}{matmul}\PYG{p}{(}\PYG{n}{H\PYGZus{}H}\PYG{p}{,} \PYG{n}{H}\PYG{p}{)}                          \PYG{c+c1}{\PYGZsh{} (N, Nt, Nt)}

    \PYG{c+c1}{\PYGZsh{} Chequeo de invertibilidad: usar pseudo\PYGZhy{}inversa si necesario}
    \PYG{n}{s\PYGZus{}hat} \PYG{o}{=} \PYG{n}{xp}\PYG{o}{.}\PYG{n}{zeros}\PYG{p}{((}\PYG{n}{N}\PYG{p}{,} \PYG{n}{Nt}\PYG{p}{,} \PYG{n}{Ns}\PYG{p}{),} \PYG{n}{dtype}\PYG{o}{=}\PYG{n+nb}{complex}\PYG{p}{)}
    \PYG{n}{eps} \PYG{o}{=} \PYG{l+m+mf}{1e\PYGZhy{}12}
    \PYG{k}{for} \PYG{n}{i} \PYG{o+ow}{in} \PYG{n+nb}{range}\PYG{p}{(}\PYG{n}{N}\PYG{p}{):}
        \PYG{k}{try}\PYG{p}{:}
            \PYG{n}{Rinv} \PYG{o}{=} \PYG{n}{xp}\PYG{o}{.}\PYG{n}{linalg}\PYG{o}{.}\PYG{n}{inv}\PYG{p}{(}\PYG{n}{R}\PYG{p}{[}\PYG{n}{i}\PYG{p}{])}
        \PYG{k}{except} \PYG{n+ne}{Exception}\PYG{p}{:}
            \PYG{c+c1}{\PYGZsh{} si no invertible, usar pseudo\PYGZhy{}inversa}
            \PYG{n}{Rinv} \PYG{o}{=} \PYG{n}{xp}\PYG{o}{.}\PYG{n}{linalg}\PYG{o}{.}\PYG{n}{pinv}\PYG{p}{(}\PYG{n}{R}\PYG{p}{[}\PYG{n}{i}\PYG{p}{])}
        \PYG{n}{Wz} \PYG{o}{=} \PYG{n}{Rinv} \PYG{o}{@} \PYG{n}{H\PYGZus{}H}\PYG{p}{[}\PYG{n}{i}\PYG{p}{]}                          \PYG{c+c1}{\PYGZsh{} (Nt, Nr)}
        \PYG{n}{s\PYGZus{}hat}\PYG{p}{[}\PYG{n}{i}\PYG{p}{]} \PYG{o}{=} \PYG{p}{(}\PYG{n}{Wz} \PYG{o}{@} \PYG{n}{Y}\PYG{p}{[}\PYG{n}{i}\PYG{p}{])}                     \PYG{c+c1}{\PYGZsh{} (Nt, Ns)}

    \PYG{k}{return} \PYG{n}{s\PYGZus{}hat}\PYG{p}{,} \PYG{n}{S\PYGZus{}streams}



\PYG{c+c1}{\PYGZsh{} Cell: Transmisión + Decodificación MMSE (batch, CPU/GPU compatible)}
\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{transmit\PYGZus{}and\PYGZus{}mmse\PYGZus{}decode}\PYG{p}{(}\PYG{n}{H}\PYG{p}{,} \PYG{n}{S\PYGZus{}streams}\PYG{p}{,} \PYG{n}{N0}\PYG{p}{,} \PYG{n}{Es}\PYG{p}{,} \PYG{n}{xp}\PYG{p}{):}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{    Decodificación MMSE en el receptor.}
\PYG{l+s+sd}{    H: (N, Nr, Nt)}
\PYG{l+s+sd}{    S\PYGZus{}streams: (N, Nt, Ns) \PYGZhy{}\PYGZgt{} símbolos transmitidos por cada antena tx}
\PYG{l+s+sd}{    N0: ruido}
\PYG{l+s+sd}{    Es: energía total por símbolo (se reparte en Nt streams)}
\PYG{l+s+sd}{    xp: numpy o cupy}
\PYG{l+s+sd}{    Retorna: s\PYGZus{}hat (N, Nt, Ns), S\PYGZus{}streams (verdaderos)}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{n}{N}\PYG{p}{,} \PYG{n}{Nr}\PYG{p}{,} \PYG{n}{Nt} \PYG{o}{=} \PYG{n}{H}\PYG{o}{.}\PYG{n}{shape}
    \PYG{n}{\PYGZus{}}\PYG{p}{,} \PYG{n}{Nt2}\PYG{p}{,} \PYG{n}{Ns} \PYG{o}{=} \PYG{n}{S\PYGZus{}streams}\PYG{o}{.}\PYG{n}{shape}
    \PYG{k}{assert} \PYG{n}{Nt2} \PYG{o}{==} \PYG{n}{Nt}

    \PYG{c+c1}{\PYGZsh{} Transmisión}
    \PYG{n}{X} \PYG{o}{=} \PYG{n}{S\PYGZus{}streams}                          \PYG{c+c1}{\PYGZsh{} (N,Nt,Ns)}
    \PYG{n}{Y} \PYG{o}{=} \PYG{n}{xp}\PYG{o}{.}\PYG{n}{einsum}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}nij, njs \PYGZhy{}\PYGZgt{} nis\PYGZsq{}}\PYG{p}{,} \PYG{n}{H}\PYG{p}{,} \PYG{n}{X}\PYG{p}{)} \PYG{c+c1}{\PYGZsh{} (N,Nr,Ns)}
    \PYG{n}{Y} \PYG{o}{+=} \PYG{n}{awgn\PYGZus{}noise}\PYG{p}{(}\PYG{n}{Y}\PYG{o}{.}\PYG{n}{shape}\PYG{p}{,} \PYG{n}{N0}\PYG{p}{,} \PYG{n}{xp}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} Parámetro de regularización: N0 / E\PYGZus{}s\PYGZus{}stream}
    \PYG{n}{E\PYGZus{}s\PYGZus{}stream} \PYG{o}{=} \PYG{n}{Es} \PYG{o}{/} \PYG{n}{Nt}
    \PYG{n}{reg} \PYG{o}{=} \PYG{n}{N0} \PYG{o}{/} \PYG{p}{(}\PYG{n}{E\PYGZus{}s\PYGZus{}stream} \PYG{o}{+} \PYG{l+m+mf}{1e\PYGZhy{}18}\PYG{p}{)}

    \PYG{n}{s\PYGZus{}hat} \PYG{o}{=} \PYG{n}{xp}\PYG{o}{.}\PYG{n}{zeros}\PYG{p}{((}\PYG{n}{N}\PYG{p}{,} \PYG{n}{Nt}\PYG{p}{,} \PYG{n}{Ns}\PYG{p}{),} \PYG{n}{dtype}\PYG{o}{=}\PYG{n+nb}{complex}\PYG{p}{)}
    \PYG{n}{ident} \PYG{o}{=} \PYG{k+kc}{None}

    \PYG{c+c1}{\PYGZsh{} Calculamos W\PYGZus{}mmse por realización (puede vectorizarse si xp soporta batched solve)}
    \PYG{k}{for} \PYG{n}{i} \PYG{o+ow}{in} \PYG{n+nb}{range}\PYG{p}{(}\PYG{n}{N}\PYG{p}{):}
        \PYG{n}{Hi} \PYG{o}{=} \PYG{n}{H}\PYG{p}{[}\PYG{n}{i}\PYG{p}{]}                          \PYG{c+c1}{\PYGZsh{} (Nr, Nt)}
        \PYG{n}{H\PYGZus{}H} \PYG{o}{=} \PYG{n}{Hi}\PYG{o}{.}\PYG{n}{conj}\PYG{p}{()}\PYG{o}{.}\PYG{n}{T}                  \PYG{c+c1}{\PYGZsh{} (Nt, Nr)}
        \PYG{n}{A} \PYG{o}{=} \PYG{n}{H\PYGZus{}H} \PYG{o}{@} \PYG{n}{Hi}                       \PYG{c+c1}{\PYGZsh{} (Nt, Nt)}
        \PYG{k}{if} \PYG{n}{ident} \PYG{o+ow}{is} \PYG{k+kc}{None} \PYG{o+ow}{or} \PYG{n}{ident}\PYG{o}{.}\PYG{n}{shape}\PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{]} \PYG{o}{!=} \PYG{n}{Nt}\PYG{p}{:}
