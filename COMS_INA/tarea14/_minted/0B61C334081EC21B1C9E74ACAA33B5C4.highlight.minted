\PYG{c+c1}{\PYGZsh{} CHECKPOINT QPSK rápido (CPU)}
\PYG{n}{xp\PYGZus{}test} \PYG{o}{=} \PYG{n}{np}
\PYG{n}{bits\PYGZus{}test} \PYG{o}{=} \PYG{n}{xp\PYGZus{}test}\PYG{o}{.}\PYG{n}{random}\PYG{o}{.}\PYG{n}{randint}\PYG{p}{(}\PYG{l+m+mi}{0}\PYG{p}{,}\PYG{l+m+mi}{2}\PYG{p}{,(}\PYG{l+m+mi}{50000}\PYG{p}{,}\PYG{l+m+mi}{2}\PYG{p}{))}
