    \PYG{k}{return} \PYG{n}{S}

\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{fading\PYGZus{}rayleigh\PYGZus{}fd}\PYG{p}{(}\PYG{n}{v}\PYG{p}{,} \PYG{n}{fc}\PYG{p}{,} \PYG{n}{Ts}\PYG{p}{,} \PYG{n}{Td}\PYG{p}{,} \PYG{n}{seed}\PYG{o}{=}\PYG{l+m+mi}{0}\PYG{p}{,} \PYG{n}{Nfreq}\PYG{o}{=}\PYG{k+kc}{None}\PYG{p}{):}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}Genera una secuencia Rayleigh correlacionada en el tiempo usando el método FD.\PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{n}{c} \PYG{o}{=} \PYG{l+m+mf}{3e8}
    \PYG{n}{fD} \PYG{o}{=} \PYG{p}{(}\PYG{n}{v} \PYG{o}{*} \PYG{n}{fc}\PYG{p}{)} \PYG{o}{/} \PYG{n}{c}  \PYG{c+c1}{\PYGZsh{} Doppler máximo}
    \PYG{n}{N} \PYG{o}{=} \PYG{n+nb}{int}\PYG{p}{(}\PYG{n}{np}\PYG{o}{.}\PYG{n}{round}\PYG{p}{(}\PYG{n}{Td} \PYG{o}{/} \PYG{n}{Ts}\PYG{p}{))}
