        \PYG{n}{Nfft} \PYG{o}{=} \PYG{l+m+mi}{1} \PYG{o}{\PYGZlt{}\PYGZlt{}} \PYG{p}{(}\PYG{n+nb}{int}\PYG{p}{(}\PYG{n}{np}\PYG{o}{.}\PYG{n}{ceil}\PYG{p}{(}\PYG{n}{np}\PYG{o}{.}\PYG{n}{log2}\PYG{p}{(}\PYG{n}{N}\PYG{p}{)))} \PYG{o}{+} \PYG{l+m+mi}{2}\PYG{p}{)}
    \PYG{k}{else}\PYG{p}{:}
        \PYG{n}{Nfft} \PYG{o}{=} \PYG{n+nb}{int}\PYG{p}{(}\PYG{n}{Nfreq}\PYG{p}{)}
    \PYG{n}{freqs} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{fft}\PYG{o}{.}\PYG{n}{fftfreq}\PYG{p}{(}\PYG{n}{Nfft}\PYG{p}{,} \PYG{n}{d}\PYG{o}{=}\PYG{n}{Ts}\PYG{p}{)}
    \PYG{n}{S} \PYG{o}{=} \PYG{n}{clarke\PYGZus{}psd}\PYG{p}{(}\PYG{n}{freqs}\PYG{p}{,} \PYG{n}{fD}\PYG{p}{)}
    \PYG{n}{rng} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{random}\PYG{o}{.}\PYG{n}{default\PYGZus{}rng}\PYG{p}{(}\PYG{n}{seed}\PYG{p}{)}
    \PYG{n}{spec} \PYG{o}{=} \PYG{p}{(}\PYG{n}{rng}\PYG{o}{.}\PYG{n}{normal}\PYG{p}{(}\PYG{n}{size}\PYG{o}{=}\PYG{n}{Nfft}\PYG{p}{)} \PYG{o}{+} \PYG{l+m+mi}{1}\PYG{n}{j} \PYG{o}{*} \PYG{n}{rng}\PYG{o}{.}\PYG{n}{normal}\PYG{p}{(}\PYG{n}{size}\PYG{o}{=}\PYG{n}{Nfft}\PYG{p}{))} \PYG{o}{*} \PYG{n}{np}\PYG{o}{.}\PYG{n}{sqrt}\PYG{p}{(}\PYG{n}{S} \PYG{o}{/} \PYG{l+m+mf}{2.0}\PYG{p}{)}
    \PYG{n}{h\PYGZus{}time} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{fft}\PYG{o}{.}\PYG{n}{ifft}\PYG{p}{(}\PYG{n}{np}\PYG{o}{.}\PYG{n}{fft}\PYG{o}{.}\PYG{n}{ifftshift}\PYG{p}{(}\PYG{n}{spec}\PYG{p}{))}
    \PYG{n}{h} \PYG{o}{=} \PYG{n}{h\PYGZus{}time}\PYG{p}{[:}\PYG{n}{N}\PYG{p}{]}
    \PYG{n}{h} \PYG{o}{/=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{sqrt}\PYG{p}{(}\PYG{n}{np}\PYG{o}{.}\PYG{n}{mean}\PYG{p}{(}\PYG{n}{np}\PYG{o}{.}\PYG{n}{abs}\PYG{p}{(}\PYG{n}{h}\PYG{p}{)}\PYG{o}{**}\PYG{l+m+mi}{2}\PYG{p}{))}  \PYG{c+c1}{\PYGZsh{} normalización RMS = 1}
    \PYG{n}{t} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{arange}\PYG{p}{(}\PYG{n}{N}\PYG{p}{)} \PYG{o}{*} \PYG{n}{Ts}
    \PYG{k}{return} \PYG{n}{h}\PYG{p}{,} \PYG{n}{fD}\PYG{p}{,} \PYG{n}{t}

\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{compute\PYGZus{}mean\PYGZus{}rms}\PYG{p}{(}\PYG{n}{r}\PYG{p}{):}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}Calcula media y RMS de un vector real.\PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{n}{mean\PYGZus{}r} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{mean}\PYG{p}{(}\PYG{n}{r}\PYG{p}{)}
