\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{compute\PYGZus{}snr\PYGZus{}values}\PYG{p}{(}\PYG{n}{h\PYGZus{}list}\PYG{p}{,} \PYG{n}{gamma\PYGZus{}bar}\PYG{o}{=}\PYG{l+m+mf}{1.0}\PYG{p}{):}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{    Calcula SNR por rama y total:}
\PYG{l+s+sd}{        gamma\PYGZus{}r(n) = gamma\PYGZus{}bar * |h\PYGZus{}r(n)|\PYGZca{}2}
