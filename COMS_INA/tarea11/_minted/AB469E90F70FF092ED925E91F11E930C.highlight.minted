\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{    Calcula los pesos MRC instantáneos:}
\PYG{l+s+sd}{        u\PYGZus{}r*(n) = h\PYGZus{}r*(n) / sqrt(sum\PYGZus{}k |h\PYGZus{}k(n)|\PYGZca{}2)}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}
