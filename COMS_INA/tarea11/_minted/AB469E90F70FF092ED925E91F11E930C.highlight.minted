\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{clarke\PYGZus{}psd}\PYG{p}{(}\PYG{n}{f}\PYG{p}{,} \PYG{n}{fD}\PYG{p}{,} \PYG{n}{eps}\PYG{o}{=}\PYG{l+m+mf}{1e\PYGZhy{}9}\PYG{p}{):}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}Densidad espectral de potencia (PSD) del modelo de Clarke.\PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{n}{S} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{zeros\PYGZus{}like}\PYG{p}{(}\PYG{n}{f}\PYG{p}{,} \PYG{n}{dtype}\PYG{o}{=}\PYG{n+nb}{float}\PYG{p}{)}
