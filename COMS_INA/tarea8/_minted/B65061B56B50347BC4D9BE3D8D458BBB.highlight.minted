\PYG{c+c1}{\PYGZsh{} ===============================}
\PYG{c+c1}{\PYGZsh{} Parámetros de simulación}
\PYG{c+c1}{\PYGZsh{} ===============================}
\PYG{n}{np}\PYG{o}{.}\PYG{n}{random}\PYG{o}{.}\PYG{n}{seed}\PYG{p}{(}\PYG{l+m+mi}{1234}\PYG{p}{)}        \PYG{c+c1}{\PYGZsh{} Semilla reproducible}
\PYG{n}{Ntrials} \PYG{o}{=} \PYG{l+m+mi}{10000}             \PYG{c+c1}{\PYGZsh{} Número de realizaciones}
\PYG{n}{Nr\PYGZus{}list} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{arange}\PYG{p}{(}\PYG{l+m+mi}{1}\PYG{p}{,} \PYG{l+m+mi}{19}\PYG{p}{)}  \PYG{c+c1}{\PYGZsh{} Número de ramas (1 a 18)}
\PYG{n}{gamma\PYGZus{}bar\PYGZus{}dB} \PYG{o}{=} \PYG{l+m+mf}{17.8}         \PYG{c+c1}{\PYGZsh{} SNR media por rama en dB}
\PYG{n}{gamma\PYGZus{}bar} \PYG{o}{=} \PYG{l+m+mi}{10}\PYG{o}{**}\PYG{p}{(}\PYG{n}{gamma\PYGZus{}bar\PYGZus{}dB}\PYG{o}{/}\PYG{l+m+mi}{10}\PYG{p}{)}  \PYG{c+c1}{\PYGZsh{} Escala lineal}

\PYG{c+c1}{\PYGZsh{} ===============================}
\PYG{c+c1}{\PYGZsh{} Simulación Monte Carlo}
\PYG{c+c1}{\PYGZsh{} ===============================}
\PYG{n}{G\PYGZus{}mean} \PYG{o}{=} \PYG{p}{[]}   \PYG{c+c1}{\PYGZsh{} Ganancia promedio (lineal)}
\PYG{n}{G\PYGZus{}std}  \PYG{o}{=} \PYG{p}{[]}   \PYG{c+c1}{\PYGZsh{} Desviación estándar}

\PYG{k}{for} \PYG{n}{Nr} \PYG{o+ow}{in} \PYG{n}{Nr\PYGZus{}list}\PYG{p}{:}
    \PYG{c+c1}{\PYGZsh{} Generar Ntrials realizaciones de Nr canales independientes: h \PYGZti{} CN(0,1)}
    \PYG{n}{h} \PYG{o}{=} \PYG{p}{(}\PYG{n}{np}\PYG{o}{.}\PYG{n}{random}\PYG{o}{.}\PYG{n}{randn}\PYG{p}{(}\PYG{n}{Ntrials}\PYG{p}{,} \PYG{n}{Nr}\PYG{p}{)} \PYG{o}{+} \PYG{l+m+mi}{1}\PYG{n}{j}\PYG{o}{*}\PYG{n}{np}\PYG{o}{.}\PYG{n}{random}\PYG{o}{.}\PYG{n}{randn}\PYG{p}{(}\PYG{n}{Ntrials}\PYG{p}{,} \PYG{n}{Nr}\PYG{p}{))} \PYG{o}{/} \PYG{n}{np}\PYG{o}{.}\PYG{n}{sqrt}\PYG{p}{(}\PYG{l+m+mi}{2}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} Potencia instantánea combinada (sum |h\PYGZus{}r|\PYGZca{}2)}
    \PYG{n}{sum\PYGZus{}abs2} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{sum}\PYG{p}{(}\PYG{n}{np}\PYG{o}{.}\PYG{n}{abs}\PYG{p}{(}\PYG{n}{h}\PYG{p}{)}\PYG{o}{**}\PYG{l+m+mi}{2}\PYG{p}{,} \PYG{n}{axis}\PYG{o}{=}\PYG{l+m+mi}{1}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} SNR de salida (MRC): gamma\PYGZus{}out = gamma\PYGZus{}bar * sum |h|\PYGZca{}2}
    \PYG{n}{gamma\PYGZus{}out} \PYG{o}{=} \PYG{n}{gamma\PYGZus{}bar} \PYG{o}{*} \PYG{n}{sum\PYGZus{}abs2}

    \PYG{c+c1}{\PYGZsh{} Ganancia de arreglo (lineal)}
    \PYG{n}{G} \PYG{o}{=} \PYG{n}{sum\PYGZus{}abs2}
    \PYG{n}{G\PYGZus{}mean}\PYG{o}{.}\PYG{n}{append}\PYG{p}{(}\PYG{n}{np}\PYG{o}{.}\PYG{n}{mean}\PYG{p}{(}\PYG{n}{G}\PYG{p}{))}
    \PYG{n}{G\PYGZus{}std}\PYG{o}{.}\PYG{n}{append}\PYG{p}{(}\PYG{n}{np}\PYG{o}{.}\PYG{n}{std}\PYG{p}{(}\PYG{n}{G}\PYG{p}{)}\PYG{o}{/}\PYG{n}{np}\PYG{o}{.}\PYG{n}{sqrt}\PYG{p}{(}\PYG{n}{Ntrials}\PYG{p}{))}  \PYG{c+c1}{\PYGZsh{} error estándar de la media}

\PYG{n}{G\PYGZus{}mean} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{array}\PYG{p}{(}\PYG{n}{G\PYGZus{}mean}\PYG{p}{)}
\PYG{n}{G\PYGZus{}std}  \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{array}\PYG{p}{(}\PYG{n}{G\PYGZus{}std}\PYG{p}{)}

