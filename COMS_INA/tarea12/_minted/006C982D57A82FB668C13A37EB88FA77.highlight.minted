\PYG{c+c1}{\PYGZsh{} ==========================}
\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{plot\PYGZus{}constellation}\PYG{p}{(}\PYG{n}{S}\PYG{p}{,} \PYG{n}{title}\PYG{p}{,} \PYG{n}{filename}\PYG{p}{):}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{    Dibuja la constelación QPSK de una fila de S (Ns símbolos).}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{n}{plt}\PYG{o}{.}\PYG{n}{figure}\PYG{p}{(}\PYG{n}{figsize}\PYG{o}{=}\PYG{p}{(}\PYG{l+m+mf}{4.5}\PYG{p}{,} \PYG{l+m+mf}{4.5}\PYG{p}{))}
    \PYG{n}{plt}\PYG{o}{.}\PYG{n}{plot}\PYG{p}{(}\PYG{n}{np}\PYG{o}{.}\PYG{n}{real}\PYG{p}{(}\PYG{n}{S}\PYG{p}{),} \PYG{n}{np}\PYG{o}{.}\PYG{n}{imag}\PYG{p}{(}\PYG{n}{S}\PYG{p}{),} \PYG{l+s+s1}{\PYGZsq{}o\PYGZsq{}}\PYG{p}{,} \PYG{n}{markersize}\PYG{o}{=}\PYG{l+m+mi}{4}\PYG{p}{,} \PYG{n}{alpha}\PYG{o}{=}\PYG{l+m+mf}{0.7}\PYG{p}{)}
    \PYG{n}{plt}\PYG{o}{.}\PYG{n}{axhline}\PYG{p}{(}\PYG{l+m+mi}{0}\PYG{p}{,} \PYG{n}{color}\PYG{o}{=}\PYG{l+s+s1}{\PYGZsq{}gray\PYGZsq{}}\PYG{p}{,} \PYG{n}{linestyle}\PYG{o}{=}\PYG{l+s+s1}{\PYGZsq{}\PYGZhy{}\PYGZhy{}\PYGZsq{}}\PYG{p}{,} \PYG{n}{linewidth}\PYG{o}{=}\PYG{l+m+mf}{0.8}\PYG{p}{)}
    \PYG{n}{plt}\PYG{o}{.}\PYG{n}{axvline}\PYG{p}{(}\PYG{l+m+mi}{0}\PYG{p}{,} \PYG{n}{color}\PYG{o}{=}\PYG{l+s+s1}{\PYGZsq{}gray\PYGZsq{}}\PYG{p}{,} \PYG{n}{linestyle}\PYG{o}{=}\PYG{l+s+s1}{\PYGZsq{}\PYGZhy{}\PYGZhy{}\PYGZsq{}}\PYG{p}{,} \PYG{n}{linewidth}\PYG{o}{=}\PYG{l+m+mf}{0.8}\PYG{p}{)}
    \PYG{n}{plt}\PYG{o}{.}\PYG{n}{grid}\PYG{p}{(}\PYG{k+kc}{True}\PYG{p}{,} \PYG{n}{linestyle}\PYG{o}{=}\PYG{l+s+s1}{\PYGZsq{}\PYGZhy{}\PYGZhy{}\PYGZsq{}}\PYG{p}{,} \PYG{n}{alpha}\PYG{o}{=}\PYG{l+m+mf}{0.5}\PYG{p}{)}
    \PYG{n}{plt}\PYG{o}{.}\PYG{n}{title}\PYG{p}{(}\PYG{n}{title}\PYG{p}{)}
    \PYG{n}{plt}\PYG{o}{.}\PYG{n}{xlabel}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}Re\PYGZbs{}\PYGZob{}s\PYGZbs{}\PYGZcb{}\PYGZdq{}}\PYG{p}{)}
    \PYG{n}{plt}\PYG{o}{.}\PYG{n}{ylabel}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}Im\PYGZbs{}\PYGZob{}s\PYGZbs{}\PYGZcb{}\PYGZdq{}}\PYG{p}{)}
    \PYG{n}{plt}\PYG{o}{.}\PYG{n}{gca}\PYG{p}{()}\PYG{o}{.}\PYG{n}{set\PYGZus{}aspect}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}equal\PYGZsq{}}\PYG{p}{,} \PYG{l+s+s1}{\PYGZsq{}box\PYGZsq{}}\PYG{p}{)}
    \PYG{n}{plt}\PYG{o}{.}\PYG{n}{tight\PYGZus{}layout}\PYG{p}{()}
    \PYG{n}{plt}\PYG{o}{.}\PYG{n}{savefig}\PYG{p}{(}\PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}figs/}\PYG{l+s+si}{\PYGZob{}}\PYG{n}{filename}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{,} \PYG{n}{dpi}\PYG{o}{=}\PYG{l+m+mi}{300}\PYG{p}{)}
    \PYG{n}{plt}\PYG{o}{.}\PYG{n}{close}\PYG{p}{()}

\PYG{c+c1}{\PYGZsh{} ==========================}
\PYG{c+c1}{\PYGZsh{} (2) Graficar estructura Alamouti codificada}
\PYG{c+c1}{\PYGZsh{} ==========================}
\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{plot\PYGZus{}alamouti\PYGZus{}structure}\PYG{p}{(}\PYG{n}{S}\PYG{p}{):}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{    Codifica S con Alamouti y muestra un bloque ilustrativo de los 4 primeros símbolos.}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{n}{X} \PYG{o}{=} \PYG{n}{alamouti\PYGZus{}encode}\PYG{p}{(}\PYG{n}{S}\PYG{p}{)}
    \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}X generada: shape=}\PYG{l+s+si}{\PYGZob{}}\PYG{n}{X}\PYG{o}{.}\PYG{n}{shape}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{ (bloques Alamouti)\PYGZdq{}}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} Seleccionar primer bloque (dos tiempos)}
    \PYG{n}{s1} \PYG{o}{=} \PYG{n}{S}\PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{,} \PYG{l+m+mi}{0}\PYG{p}{]}
    \PYG{n}{s2} \PYG{o}{=} \PYG{n}{S}\PYG{p}{[}\PYG{l+m+mi}{1}\PYG{p}{,} \PYG{l+m+mi}{0}\PYG{p}{]}
    \PYG{n}{block} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{array}\PYG{p}{([[}\PYG{n}{s1}\PYG{p}{,} \PYG{o}{\PYGZhy{}}\PYG{n}{np}\PYG{o}{.}\PYG{n}{conj}\PYG{p}{(}\PYG{n}{s2}\PYG{p}{)],}
                      \PYG{p}{[}\PYG{n}{s2}\PYG{p}{,}  \PYG{n}{np}\PYG{o}{.}\PYG{n}{conj}\PYG{p}{(}\PYG{n}{s1}\PYG{p}{)]])}

    \PYG{n}{fig}\PYG{p}{,} \PYG{n}{ax} \PYG{o}{=} \PYG{n}{plt}\PYG{o}{.}\PYG{n}{subplots}\PYG{p}{(}\PYG{n}{figsize}\PYG{o}{=}\PYG{p}{(}\PYG{l+m+mi}{5}\PYG{p}{,} \PYG{l+m+mi}{3}\PYG{p}{))}
    \PYG{n}{im} \PYG{o}{=} \PYG{n}{ax}\PYG{o}{.}\PYG{n}{imshow}\PYG{p}{(}\PYG{n}{np}\PYG{o}{.}\PYG{n}{angle}\PYG{p}{(}\PYG{n}{block}\PYG{p}{),} \PYG{n}{cmap}\PYG{o}{=}\PYG{l+s+s2}{\PYGZdq{}twilight\PYGZdq{}}\PYG{p}{,} \PYG{n}{vmin}\PYG{o}{=\PYGZhy{}}\PYG{n}{np}\PYG{o}{.}\PYG{n}{pi}\PYG{p}{,} \PYG{n}{vmax}\PYG{o}{=}\PYG{n}{np}\PYG{o}{.}\PYG{n}{pi}\PYG{p}{)}
    \PYG{k}{for} \PYG{n}{i} \PYG{o+ow}{in} \PYG{n+nb}{range}\PYG{p}{(}\PYG{l+m+mi}{2}\PYG{p}{):}
        \PYG{k}{for} \PYG{n}{j} \PYG{o+ow}{in} \PYG{n+nb}{range}\PYG{p}{(}\PYG{l+m+mi}{2}\PYG{p}{):}
            \PYG{n}{text} \PYG{o}{=} \PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}}\PYG{l+s+si}{\PYGZob{}}\PYG{n}{block}\PYG{p}{[}\PYG{n}{i}\PYG{p}{,}\PYG{n}{j}\PYG{p}{]}\PYG{o}{.}\PYG{n}{real}\PYG{l+s+si}{:}\PYG{l+s+s2}{+.2f}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{+}\PYG{l+s+si}{\PYGZob{}}\PYG{n}{block}\PYG{p}{[}\PYG{n}{i}\PYG{p}{,}\PYG{n}{j}\PYG{p}{]}\PYG{o}{.}\PYG{n}{imag}\PYG{l+s+si}{:}\PYG{l+s+s2}{+.2f}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{j\PYGZdq{}}
            \PYG{n}{ax}\PYG{o}{.}\PYG{n}{text}\PYG{p}{(}\PYG{n}{j}\PYG{p}{,} \PYG{n}{i}\PYG{p}{,} \PYG{n}{text}\PYG{p}{,} \PYG{n}{ha}\PYG{o}{=}\PYG{l+s+s1}{\PYGZsq{}center\PYGZsq{}}\PYG{p}{,} \PYG{n}{va}\PYG{o}{=}\PYG{l+s+s1}{\PYGZsq{}center\PYGZsq{}}\PYG{p}{,} \PYG{n}{color}\PYG{o}{=}\PYG{l+s+s1}{\PYGZsq{}w\PYGZsq{}}\PYG{p}{,} \PYG{n}{fontsize}\PYG{o}{=}\PYG{l+m+mi}{8}\PYG{p}{)}
    \PYG{n}{plt}\PYG{o}{.}\PYG{n}{xticks}\PYG{p}{([}\PYG{l+m+mi}{0}\PYG{p}{,} \PYG{l+m+mi}{1}\PYG{p}{],} \PYG{p}{[}\PYG{l+s+sa}{r}\PYG{l+s+s2}{\PYGZdq{}t\PYGZdl{}\PYGZus{}1\PYGZdl{}\PYGZdq{}}\PYG{p}{,} \PYG{l+s+sa}{r}\PYG{l+s+s2}{\PYGZdq{}t\PYGZdl{}\PYGZus{}2\PYGZdl{}\PYGZdq{}}\PYG{p}{])}
    \PYG{n}{plt}\PYG{o}{.}\PYG{n}{yticks}\PYG{p}{([}\PYG{l+m+mi}{0}\PYG{p}{,} \PYG{l+m+mi}{1}\PYG{p}{],} \PYG{p}{[}\PYG{l+s+sa}{r}\PYG{l+s+s2}{\PYGZdq{}Antena 1\PYGZdq{}}\PYG{p}{,} \PYG{l+s+sa}{r}\PYG{l+s+s2}{\PYGZdq{}Antena 2\PYGZdq{}}\PYG{p}{])}
    \PYG{n}{plt}\PYG{o}{.}\PYG{n}{title}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}Estructura del bloque Alamouti\PYGZdq{}}\PYG{p}{)}
    \PYG{n}{plt}\PYG{o}{.}\PYG{n}{colorbar}\PYG{p}{(}\PYG{n}{im}\PYG{p}{,} \PYG{n}{label}\PYG{o}{=}\PYG{l+s+s2}{\PYGZdq{}Fase [rad]\PYGZdq{}}\PYG{p}{)}
    \PYG{n}{plt}\PYG{o}{.}\PYG{n}{tight\PYGZus{}layout}\PYG{p}{()}
    \PYG{n}{plt}\PYG{o}{.}\PYG{n}{savefig}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}figs/problema29\PYGZus{}alamouti\PYGZus{}block.png\PYGZdq{}}\PYG{p}{,} \PYG{n}{dpi}\PYG{o}{=}\PYG{l+m+mi}{300}\PYG{p}{)}
    \PYG{n}{plt}\PYG{o}{.}\PYG{n}{close}\PYG{p}{()}

    \PYG{k}{return} \PYG{n}{X}

\PYG{c+c1}{\PYGZsh{} \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZsh{} Ejemplo de uso / calibración}
\PYG{c+c1}{\PYGZsh{} \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{example\PYGZus{}usage}\PYG{p}{():}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{    Ejemplo de cómo invocar el MonteCarlo.}
\PYG{l+s+sd}{    ADVERTENCIA: NH=10000 puede tardar; prueba con NH=200 primero.}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{n}{NH} \PYG{o}{=} \PYG{l+m+mi}{10000}
    \PYG{n}{Ns} \PYG{o}{=} \PYG{l+m+mi}{1000}
    \PYG{c+c1}{\PYGZsh{} calibración: gamma=7 dB, N0=1 \PYGZhy{}\PYGZgt{} Es = gamma\PYGZus{}lin * N0}
    \PYG{n}{gamma\PYGZus{}db} \PYG{o}{=} \PYG{l+m+mf}{7.0}
    \PYG{n}{gamma\PYGZus{}lin} \PYG{o}{=} \PYG{l+m+mi}{10}\PYG{o}{**}\PYG{p}{(}\PYG{n}{gamma\PYGZus{}db}\PYG{o}{/}\PYG{l+m+mf}{10.0}\PYG{p}{)}
    \PYG{n}{N0} \PYG{o}{=} \PYG{l+m+mf}{1.0}
    \PYG{n}{Es} \PYG{o}{=} \PYG{n}{gamma\PYGZus{}lin} \PYG{o}{*} \PYG{n}{N0}

    \PYG{n}{seed\PYGZus{}symbols} \PYG{o}{=} \PYG{l+m+mi}{123}
    \PYG{n}{seed\PYGZus{}channel} \PYG{o}{=} \PYG{l+m+mi}{456}
    \PYG{n}{seed\PYGZus{}noise} \PYG{o}{=} \PYG{l+m+mi}{789}
    
    \PYG{n}{os}\PYG{o}{.}\PYG{n}{makedirs}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}figs\PYGZdq{}}\PYG{p}{,} \PYG{n}{exist\PYGZus{}ok}\PYG{o}{=}\PYG{k+kc}{True}\PYG{p}{)}


    \PYG{c+c1}{\PYGZsh{} 1) generar S}
    \PYG{n}{S} \PYG{o}{=} \PYG{n}{gen\PYGZus{}S\PYGZus{}qpsk}\PYG{p}{(}\PYG{n}{seed}\PYG{o}{=}\PYG{n}{seed\PYGZus{}symbols}\PYG{p}{,} \PYG{n}{Ns}\PYG{o}{=}\PYG{n}{Ns}\PYG{p}{,} \PYG{n}{Es}\PYG{o}{=}\PYG{n}{Es}\PYG{p}{)}
    \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}S shape:\PYGZdq{}}\PYG{p}{,} \PYG{n}{S}\PYG{o}{.}\PYG{n}{shape}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{}E[|s|\PYGZca{}2] per symbol (each antenna):\PYGZdq{}}\PYG{p}{,} \PYG{n}{np}\PYG{o}{.}\PYG{n}{mean}\PYG{p}{(}\PYG{n}{np}\PYG{o}{.}\PYG{n}{abs}\PYG{p}{(}\PYG{n}{S}\PYG{p}{)}\PYG{o}{**}\PYG{l+m+mi}{2}\PYG{p}{))}
    \PYG{n}{plot\PYGZus{}constellation}\PYG{p}{(}\PYG{n}{S}\PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{,} \PYG{p}{:],} \PYG{l+s+s2}{\PYGZdq{}Constelación QPSK \PYGZhy{} Antena 1\PYGZdq{}}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{}problema29\PYGZus{}constellation\PYGZus{}antenna1.png\PYGZdq{}}\PYG{p}{)}
    \PYG{n}{plot\PYGZus{}constellation}\PYG{p}{(}\PYG{n}{S}\PYG{p}{[}\PYG{l+m+mi}{1}\PYG{p}{,} \PYG{p}{:],} \PYG{l+s+s2}{\PYGZdq{}Constelación QPSK \PYGZhy{} Antena 2\PYGZdq{}}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{}problema29\PYGZus{}constellation\PYGZus{}antenna2.png\PYGZdq{}}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} 2) codificar Alamouti}
    \PYG{n}{X} \PYG{o}{=} \PYG{n}{alamouti\PYGZus{}encode}\PYG{p}{(}\PYG{n}{S}\PYG{p}{)}
    \PYG{n}{plot\PYGZus{}alamouti\PYGZus{}structure}\PYG{p}{(}\PYG{n}{S}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} 3) generar H (2x2)}
    \PYG{n}{H} \PYG{o}{=} \PYG{n}{gen\PYGZus{}H}\PYG{p}{(}\PYG{n}{seed}\PYG{o}{=}\PYG{n}{seed\PYGZus{}channel}\PYG{p}{)}
    \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}H:}\PYG{l+s+se}{\PYGZbs{}n}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{,} \PYG{n}{H}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} 4) generar ruido N (2 x NT)}
    \PYG{n}{NT} \PYG{o}{=} \PYG{n}{X}\PYG{o}{.}\PYG{n}{shape}\PYG{p}{[}\PYG{l+m+mi}{1}\PYG{p}{]}
    \PYG{n}{N} \PYG{o}{=} \PYG{n}{gen\PYGZus{}noise}\PYG{p}{(}\PYG{n}{seed}\PYG{o}{=}\PYG{n}{seed\PYGZus{}noise}\PYG{p}{,} \PYG{n}{N0}\PYG{o}{=}\PYG{n}{N0}\PYG{p}{,} \PYG{n}{NT}\PYG{o}{=}\PYG{n}{NT}\PYG{p}{)}
    \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}N shape:\PYGZdq{}}\PYG{p}{,} \PYG{n}{N}\PYG{o}{.}\PYG{n}{shape}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} 5) transmitir}
    \PYG{n}{Y} \PYG{o}{=} \PYG{n}{transmit\PYGZus{}STB}\PYG{p}{(}\PYG{n}{H}\PYG{p}{,} \PYG{n}{X}\PYG{p}{,} \PYG{n}{N}\PYG{p}{)}
    \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}Y shape:\PYGZdq{}}\PYG{p}{,} \PYG{n}{Y}\PYG{o}{.}\PYG{n}{shape}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} 6) decodificar}
    \PYG{n}{S} \PYG{o}{=} \PYG{n}{alamouti\PYGZus{}decode}\PYG{p}{(}\PYG{n}{Y}\PYG{p}{,} \PYG{n}{H}\PYG{p}{)}
    \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}S\PYGZus{}hat shape:\PYGZdq{}}\PYG{p}{,} \PYG{n}{S}\PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{]}\PYG{o}{.}\PYG{n}{shape}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} 7 y 8) calcular SNR por bloque}
    \PYG{n}{g\PYGZus{}per\PYGZus{}block} \PYG{o}{=} \PYG{n}{S}\PYG{p}{[}\PYG{l+m+mi}{1}\PYG{p}{]}
    \PYG{n}{gamma\PYGZus{}sym} \PYG{o}{=} \PYG{n}{snr\PYGZus{}per\PYGZus{}symbol\PYGZus{}from\PYGZus{}g}\PYG{p}{(}\PYG{n}{g\PYGZus{}per\PYGZus{}block}\PYG{p}{,} \PYG{n}{Es}\PYG{p}{,} \PYG{n}{N0}\PYG{p}{)}
    \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}gamma\PYGZus{}sym shape:\PYGZdq{}}\PYG{p}{,} \PYG{n}{gamma\PYGZus{}sym}\PYG{o}{.}\PYG{n}{shape}\PYG{p}{)}
    \PYG{n}{mean\PYGZus{}gamma} \PYG{o}{=} \PYG{n}{mean\PYGZus{}snr\PYGZus{}per\PYGZus{}realization}\PYG{p}{(}\PYG{n}{gamma\PYGZus{}sym}\PYG{p}{)}
    \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}Mean SNR per realization (lineal):\PYGZdq{}}\PYG{p}{,} \PYG{n}{mean\PYGZus{}gamma}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} 9 y 10) MonteCarlo}
