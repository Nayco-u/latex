\newlabel{fig:sph25}{{1}{3}{Spherical mirror at $f/2.5$: layout, transverse ray fan, spot diagram and polychromatic diffraction MTF. The ray fan shows the cubic signature of spherical aberration and the MTF collapses within a few tens of cycles per millimetre}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Parabolic mirror at $f/2.5$. The on-axis spot collapses to a point and the on-axis MTF follows the ideal curve; the off-axis fields keep the coma that the conic constant cannot remove.}}{3}{figure.caption.4}\protected@file@percent }
\newlabel{fig:par25}{{2}{3}{Parabolic mirror at $f/2.5$. The on-axis spot collapses to a point and the on-axis MTF follows the ideal curve; the off-axis fields keep the coma that the conic constant cannot remove}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Spherical mirror at $f/20$. The geometrical spot now fits inside the Airy disc and the MTF approaches the diffraction limit, so at this focal ratio the sphere behaves as a perfect surface.}}{4}{figure.caption.5}\protected@file@percent }
\newlabel{fig:sph20}{{3}{4}{Spherical mirror at $f/20$. The geometrical spot now fits inside the Airy disc and the MTF approaches the diffraction limit, so at this focal ratio the sphere behaves as a perfect surface}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Classical Cassegrain, $f/15$. The on-axis spot is a point; the off-axis spots grow quadratically with the field angle.}}{4}{figure.caption.8}\protected@file@percent }
\newlabel{fig:cass}{{4}{4}{Classical Cassegrain, $f/15$. The on-axis spot is a point; the off-axis spots grow quadratically with the field angle}{figure.caption.8}{}}
